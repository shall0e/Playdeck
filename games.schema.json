{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Playdeck game catalog",
  "type": "object",
  "required": ["version", "games"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string" },
    "games": {
      "type": "array", "minItems": 1, "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "category", "playUrl", "image", "sourceUrl", "creator", "controls"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "playUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "image": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "creator": { "type": "string", "minLength": 1 },
          "controls": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "mobile": { "type": "boolean" },
          "multiplayer": { "type": "boolean" },
          "featured": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "license": { "type": "string" }
        }
      }
    }
  }
}
